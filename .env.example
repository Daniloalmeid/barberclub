# Build, sem segredo. Aparecem em /api/health.
APP_VERSION=0.0.0
GIT_COMMIT=unknown
BUILD_TIME=unknown

# Configuração. A chave publicável não é segredo por desenho.
APP_ENV=development
ROOT_DOMAIN=barber.workloop.com.br
PUBLIC_SCHEME=http
PUBLIC_PORT=3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

